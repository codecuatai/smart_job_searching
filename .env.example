# Copy to .env and fill GEMINI_API_KEY with a key from Google AI Studio.
COMPOSE_PROJECT_NAME=unitalent
WEB_PORT=3000
API_PORT=8000
AI_PORT=8001
SEED_DEMO=true
DEMO_PASSWORD=demo12345
COOKIE_SECURE=false
DATA_VOLUME=unitalent_data
DATA_VOLUME_EXTERNAL=false

# Gemini is used for generative AI tasks. Keep this file secret-free.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=true
GEMINI_TIMEOUT_SECONDS=25

# Optional overrides
# ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# DATABASE_PATH=var/data/unitalent.db
# API_URL=http://127.0.0.1:8000
# AI_SERVICE_URL=http://127.0.0.1:8001
