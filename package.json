{
  "name": "unitalent-ai",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/web.mjs build",
    "lint": "npm --prefix apps/web run lint",
    "typecheck": "npm --prefix apps/web run typecheck",
    "test": "node scripts/test.mjs",
    "test:e2e": "npm --prefix apps/web run test:e2e",
    "test:e2e:report": "npm --prefix apps/web run test:e2e:report",
    "jobs:crawl": "node scripts/crawl-jobs.mjs",
    "jobs:import": "node scripts/manage-jobs.mjs import",
    "jobs:cleanup-e2e": "node scripts/manage-jobs.mjs cleanup-e2e",
    "ai:train": "python scripts/train_matching_model.py",
    "ai:evaluate": "python scripts/evaluate_matching.py",
    "ai:benchmark": "python scripts/benchmark_matching.py",
    "db:backup": "node scripts/database.mjs backup",
    "db:restore": "node scripts/database.mjs restore",
    "db:verify-recovery": "node scripts/verify-recovery.mjs",
    "bi:refresh": "node scripts/database.mjs refresh",
    "bi:verify": "node scripts/database.mjs verify",
    "docker:up": "node scripts/docker.mjs up",
    "docker:test": "node scripts/docker.mjs test",
    "docker:down": "node scripts/docker.mjs down",
    "docker:logs": "node scripts/docker.mjs logs",
    "docker:ps": "node scripts/docker.mjs ps",
    "git:check": "node scripts/check-staged.mjs",
    "git:hooks": "git config core.hooksPath .githooks",
    "env:init": "node scripts/env-init.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
